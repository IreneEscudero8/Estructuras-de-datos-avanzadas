import java.util.Iterator;

/**
 *
 * @author RAGJ
 */
public class ListaDoble<T> implements Iterable<T>{

    private NodoDoble <T> primero;
    private NodoDoble <T> ultimo;

    public ListaDoble() {
        this.primero = null;
        this.ultimo = null;
    }
    
    public boolean estaVacia(){
        return primero == null;
    }
    
    public void agregaInicio(T dato){
        NodoDoble<T> nuevo = new NodoDoble(dato);
        if(estaVacia()){
           ultimo = nuevo;
           
        }else{
            nuevo.setSiguiente(primero);
            primero.setAnterior(nuevo);
        }
        primero = nuevo;   
    }
    
    public void agregaFinal(T dato){
        NodoDoble<T> nuevo = new NodoDoble(dato);
        if(estaVacia()){
           primero = nuevo;
           
        }else{
            ultimo.setSiguiente(nuevo);
            nuevo.setAnterior(ultimo);
        }
        ultimo = nuevo;  
    }
    
    public T quitaPrimero(){
        T eliminado = null;
        if(!estaVacia()){
            eliminado = primero.getDato();
            primero = primero.getSiguiente();
            if (primero == null){ //Habia solo 1 nodo
                ultimo = null;   //Quedo vacia
            }else{
                primero.getAnterior().setSiguiente(null);
                primero.setAnterior(null);
            }
        }
        return eliminado;
    }
    
    public T quitaUltimo(){
        T eliminado = null;
        if(!estaVacia()){
            eliminado = primero.getDato();
            ultimo = ultimo.getAnterior();
            if (ultimo == null){ //Habia solo 1 nodo
                primero = null;   //Quedo vacia
            }else{
                ultimo.getSiguiente().setAnterior(null);
                ultimo.setSiguiente(null);
            }
        }
        return eliminado;
    }
    
    public T quitaDato(T dato){
        T eliminado = null;
        if (!estaVacia()){
            boolean encIzq = false;
            boolean encDer = false;
            NodoDoble <T> izq = primero;
            NodoDoble <T> der = ultimo;
            while (izq != der && !encIzq && !encDer && izq != der.getAnterior()){
                if (dato.equals(izq.getDato()))
                    encIzq = true;
                else
                    if (dato.equals(der.getDato()))
                        encDer = true;
                    else{
                        izq = izq.getSiguiente();
                        der = der.getAnterior();
                    }
            }
            if(!encIzq && !encDer)
                if (dato.equals(izq.getDato()))
                    encIzq = true;
                else
                    if (dato.equals(der.getDato()))
                        encDer = true;
            if (encIzq){
                eliminado = izq.getDato();
                if (izq == primero){ // Caso de que sea el primero
                    primero = primero.getSiguiente();
                    if (primero == null) //solo 1 nodo
                        ultimo = null;
                    else
                        primero.setAnterior(null);
                } else { // Coincidio en el medio
                    izq.getAnterior().setSiguiente(izq.getSiguiente());
                    izq.getSiguiente().setAnterior(izq.getAnterior());
                    izq.setAnterior(null);
                    izq.setSiguiente(null);
                }
                
            }else{
                if(encDer){
                    eliminado = der.getDato();
                    if (der == ultimo){ // Caso de que sea el ultimo
                        ultimo = ultimo.getAnterior();
                        ultimo.setSiguiente(null);
                    } else { // Coincidio en el medio
                        der.getAnterior().setSiguiente(der.getSiguiente());
                        der.getSiguiente().setAnterior(der.getAnterior());
                        der.setAnterior(null);
                        der.setSiguiente(null);
                    } 
                }
                
            } 
        }
        return eliminado;
    }

    @Override
    public Iterator<T> iterator() {
        return new IteradorDoble(primero);
    }
    
    @Override
    public String toString(){
        StringBuilder sB = new StringBuilder();
        
        for(T dato : this)
            sB.append(dato).append(" ");
        return sB.toString();
    }  
}
